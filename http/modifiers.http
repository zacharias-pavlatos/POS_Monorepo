#   "name": "Large",
#   "description": "20 oz",
#   "basePrice": 100,
#   "isActive": true,
#   "displayOrder": 2
# }


### Create topping modifiers - ok
POST {{baseUrl}}{{apiPrefix}}/modifiers
Content-Type: application/json
Origin: {{origin}}
Referer: {{origin}}/

{
  "modifierGroupId": "41ef3559-f5cf-43a6-9c33-347b6c828da6",
  "name": "Extra Cheese",
  "basePrice": 150,
  "isActive": true,
  "displayOrder": 0
}

